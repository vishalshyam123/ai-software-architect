# ===================================================
# AI Software Architect - Environment Variables
# ===================================================

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_architect

# AI Model Configuration
# Note: If OPENAI_API_KEY is left empty, the built-in Intelligent Heuristic
# Architecture Engine automatically generates complete, production-grade blueprints!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Backend Port and Environment
PORT=8000
ENVIRONMENT=production
